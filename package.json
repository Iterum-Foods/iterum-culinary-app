{
  "name": "iterum-culinary-app",
  "version": "1.0.0",
  "description": "A comprehensive culinary research and development application for chefs and food service professionals",
  "main": "index.html",
  "scripts": {
    "start": "http-server public -p 8080 -o",
    "dev": "http-server public -p 8080 -o -c-1",
    "mobile:serve": "http-server public -p 8080 -a 0.0.0.0 -c-1",
    "serve:test": "http-server public -p 8080 -c-1",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:smoke:prod": "playwright test -c playwright.prod.config.js --project=chromium",
    "owner-bot": "node scripts/owner-bot/owner-bot-iterum.js",
    "owner-bot:init": "node -e \"const fs=require('fs');const p='scripts/owner-bot/.env.owner-bot';const e='scripts/owner-bot/env.owner-bot.example';if(fs.existsSync(p)){console.log('Already exists:',p);}else{fs.copyFileSync(e,p);console.log('Created',p,'— add ITERUM_TEST_EMAIL and ITERUM_TEST_PASSWORD');}\"",
    "owner-bot:run": "powershell -ExecutionPolicy Bypass -File scripts/owner-bot/run-owner-bot.ps1",
    "owner-bot:provision": "node scripts/owner-bot/owner-bot-provision.js",
    "owner-bot:develop": "node scripts/owner-bot/owner-bot-develop.js",
    "owner-bot:compliance": "node scripts/owner-bot/owner-bot-compliance.js",
    "verify:sprints": "npm run lint && npm run format:check && npm run test:chromium",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "lint": "eslint \"public/assets/js/**/*.js\" --max-warnings 10000",
    "lint:fix": "eslint \"public/assets/js/**/*.js\" --fix",
    "format": "prettier --write \"public/assets/js/**/*.js\" \"public/assets/css/**/*.css\"",
    "format:check": "prettier --check \"public/assets/js/**/*.js\" \"public/assets/css/**/*.css\"",
    "build": "echo 'No build step required for static app'",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:android": "npx cap sync android && npx cap open android",
    "prepare": "husky install"
  },
  "keywords": [
    "culinary",
    "recipe",
    "chef",
    "food-service",
    "research",
    "development",
    "project-management"
  ],
  "author": "Iterum Culinary Team",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^7.6.1",
    "@capacitor/cli": "^7.6.1",
    "@capacitor/core": "^7.6.1",
    "@capacitor/ios": "^7.6.1",
    "@playwright/test": "^1.59.1",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.0"
  },
  "dependencies": {
    "http-server": "^14.1.1"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Iterum-Foods/iterum-culinary-app.git"
  },
  "bugs": {
    "url": "https://github.com/Iterum-Foods/iterum-culinary-app/issues"
  },
  "homepage": "https://github.com/Iterum-Foods/iterum-culinary-app#readme"
}
