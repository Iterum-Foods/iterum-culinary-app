// iterum-culinary-app2 — last tightened: employee_line read-only on project menus/recipes/snapshots
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user owns the document (strict: Firestore doc id must be auth uid)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Project doc access: firebaseUid (preferred), or legacy ownerId / ownerEmail
    function projectDocData(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function canCreateProjectDoc() {
      return isAuthenticated()
        && request.resource.data.keys().hasAny(['firebaseUid'])
        && request.resource.data.firebaseUid == request.auth.uid;
    }

    function canUpdateProjectDoc(projectId) {
      return isAuthenticated()
        && (
          (
            resource.data.keys().hasAny(['firebaseUid'])
            && resource.data.firebaseUid == request.auth.uid
            && request.resource.data.firebaseUid == resource.data.firebaseUid
          )
          || (
            !resource.data.keys().hasAny(['firebaseUid'])
            && request.resource.data.keys().hasAny(['firebaseUid'])
            && request.resource.data.firebaseUid == request.auth.uid
            && (
              projectOwnerSlugMatchesAuth(projectId)
              || (
                projectDocData(projectId).keys().hasAny(['ownerEmail'])
                && projectDocData(projectId).ownerEmail == request.auth.token.email
              )
              || projectDocData(projectId).ownerId == request.auth.uid
            )
          )
        );
    }

    function canDeleteProjectDoc() {
      return isAuthenticated()
        && resource.data.keys().hasAny(['firebaseUid'])
        && resource.data.firebaseUid == request.auth.uid;
    }
    
    // Check if email is valid
    function isValidEmail(email) {
      return email is string && email.matches('.*@.*[.].*');
    }
    
    // Writes: cap document size; deletes have no request.resource
    function isValidSize() {
      return request.resource == null || request.resource.size() < 1000000;
    }

    // userId path aligns with auth uid OR existing profile email (slug ids from client)
    function userProfileEmailMatches(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.email
          == request.auth.token.email;
    }

    // project.ownerId often mirrors `users/{slug}` document id from client
    function projectOwnerSlugMatchesAuth(projectId) {
      return projectDocData(projectId).keys().hasAny(['ownerId'])
        && userProfileEmailMatches(projectDocData(projectId).ownerId);
    }

    // Project owner only (legacy project doc fields) — not a members/{uid} row
    function isProjectOwnerOnly(projectId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && (
          projectDocData(projectId).firebaseUid == request.auth.uid
          || projectDocData(projectId).ownerId == request.auth.uid
          || (
            projectDocData(projectId).keys().hasAny(['ownerEmail'])
            && projectDocData(projectId).ownerEmail == request.auth.token.email
          )
          || projectOwnerSlugMatchesAuth(projectId)
        );
    }

    function projectMemberDocPath(projectId, uid) {
      return /databases/$(database)/documents/projects/$(projectId)/members/$(uid);
    }

    function isProjectMember(projectId) {
      return isAuthenticated()
        && exists(projectMemberDocPath(projectId, request.auth.uid));
    }

    function projectMemberRole(projectId) {
      return get(projectMemberDocPath(projectId, request.auth.uid)).data.role;
    }

    function isAccountAdminMember(projectId) {
      return isProjectMember(projectId) && projectMemberRole(projectId) == 'account_admin';
    }

    function isValidMemberRole(r) {
      return r == 'account_admin'
        || r == 'location_manager'
        || r == 'employee_line'
        || r == 'chef_leadership'
        || r == 'operations_gm'
        || r == 'purchasing'
        || r == 'consultant_rd';
    }

    // Owner OR invited member (company / workspace access)
    function canAccessProjectDoc(projectId) {
      return isProjectOwnerOnly(projectId) || isProjectMember(projectId);
    }

    // Line staff: read project data; write checklists only (no menu/recipe/snapshot edits)
    function isEmployeeLineMember(projectId) {
      return isProjectMember(projectId) && projectMemberRole(projectId) == 'employee_line';
    }

    function canWriteProjectMenusRecipesSnapshots(projectId) {
      return canAccessProjectDoc(projectId) && !isEmployeeLineMember(projectId);
    }

    // ============================================
    // USER PROFILES
    // ============================================
    
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      
      // Users can create their own profile
      allow create: if isOwner(userId) 
                    && isValidSize()
                    && request.resource.data.email is string
                    && request.resource.data.name is string;
      
      // Users can update their own profile
      allow update: if isOwner(userId)
                    && isValidSize()
                    // Prevent changing critical fields
                    && request.resource.data.userId == resource.data.userId;
      
      // Users can delete their own profile
      allow delete: if isOwner(userId);
      
      // ============================================
      // USER SUB-COLLECTIONS
      // ============================================
      
      // Recipes sub-collection
      match /recipes/{recipeId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidSize();
      }
      
      // Ingredients sub-collection
      match /ingredients/{ingredientId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidSize();
      }
      
      // Projects sub-collection
      match /projects/{projectId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidSize();
      }
      
      // Menus sub-collection
      match /menus/{menuId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidSize();
      }
      
      // Equipment sub-collection
      match /equipment/{equipmentId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidSize();
      }
      
      // Vendors sub-collection
      match /vendors/{vendorId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidSize();
      }
      
      // Inventory sub-collection
      match /inventory/{inventoryId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidSize();
      }
      
      // Notes sub-collection
      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidSize();
      }

      // Snapshots (e.g. recipeLibrary — firestore-sync.js; user doc id may be slug)
      match /snapshots/{snapshotId} {
        allow read: if isAuthenticated()
          && (isOwner(userId) || userProfileEmailMatches(userId));
        allow write: if isAuthenticated() && isValidSize()
          && (isOwner(userId) || userProfileEmailMatches(userId));
      }

      // HACCP / compliance (dashboard + calendar; userId = Firebase uid or slug with email match)
      match /refrigeration_units/{unitId} {
        allow read: if isAuthenticated()
          && (isOwner(userId) || userProfileEmailMatches(userId));
        allow write: if isAuthenticated() && isValidSize()
          && (isOwner(userId) || userProfileEmailMatches(userId));
      }
      match /sanitizer_locations/{locId} {
        allow read: if isAuthenticated()
          && (isOwner(userId) || userProfileEmailMatches(userId));
        allow write: if isAuthenticated() && isValidSize()
          && (isOwner(userId) || userProfileEmailMatches(userId));
      }
      match /temperature_readings/{readingId} {
        allow read: if isAuthenticated()
          && (isOwner(userId) || userProfileEmailMatches(userId));
        allow write: if isAuthenticated() && isValidSize()
          && (isOwner(userId) || userProfileEmailMatches(userId));
      }
      match /sanitizer_readings/{readingId} {
        allow read: if isAuthenticated()
          && (isOwner(userId) || userProfileEmailMatches(userId));
        allow write: if isAuthenticated() && isValidSize()
          && (isOwner(userId) || userProfileEmailMatches(userId));
      }

      // Health inspection: configurable areas + completed rounds (calendar)
      match /inspection_areas/{areaId} {
        allow read: if isAuthenticated()
          && (isOwner(userId) || userProfileEmailMatches(userId));
        allow write: if isAuthenticated() && isValidSize()
          && (isOwner(userId) || userProfileEmailMatches(userId));
      }
      match /inspection_logs/{logId} {
        allow read: if isAuthenticated()
          && (isOwner(userId) || userProfileEmailMatches(userId));
        allow write: if isAuthenticated() && isValidSize()
          && (isOwner(userId) || userProfileEmailMatches(userId));
      }
    }
    
    // ============================================
    // PROJECTS (Top-level collection)
    // ============================================
    
    match /projects/{projectId} {
      // Single-doc get + queries: each returned doc must pass canAccessProjectDoc.
      // Broad unfiltered collection scans still fail rule evaluation (no false allow list).
      allow read: if canAccessProjectDoc(projectId);

      allow create: if canCreateProjectDoc() && isValidSize();
      allow update: if canUpdateProjectDoc(projectId) && isValidSize();
      allow delete: if canDeleteProjectDoc();

      // Project sub-collections — same tenant as parent project doc
      match /snapshots/{snapshotId} {
        allow read: if canAccessProjectDoc(projectId);
        allow write: if canWriteProjectMenusRecipesSnapshots(projectId) && isValidSize();
      }

      match /menus/{menuId} {
        allow read: if canAccessProjectDoc(projectId);
        allow write: if canWriteProjectMenusRecipesSnapshots(projectId) && isValidSize();
      }

      match /recipes/{recipeId} {
        allow read: if canAccessProjectDoc(projectId);
        allow write: if canWriteProjectMenusRecipesSnapshots(projectId) && isValidSize();
      }

      match /checklists/{checklistId} {
        allow read, write: if canAccessProjectDoc(projectId) && isValidSize();
      }

      // Company / workspace membership (uid = Firebase Auth uid)
      match /members/{memberId} {
        allow read: if canAccessProjectDoc(projectId);

        allow create: if isValidSize()
          && request.resource.data.keys().hasAny(['role'])
          && request.resource.data.role is string
          && isValidMemberRole(request.resource.data.role)
          && (
            isProjectOwnerOnly(projectId)
            || isAccountAdminMember(projectId)
          );

        allow update: if isValidSize()
          && request.resource.data.role is string
          && isValidMemberRole(request.resource.data.role)
          && (
            isProjectOwnerOnly(projectId)
            || isAccountAdminMember(projectId)
          );

        allow delete: if isProjectOwnerOnly(projectId) || isAccountAdminMember(projectId);
      }
    }
    
    // ============================================
    // SHARED/PUBLIC DATA
    // ============================================
    
    // Public recipe ideas (read-only for inspiration)
    match /public_recipes/{recipeId} {
      allow read: if isAuthenticated();
      allow write: if false; // Managed by admin only
    }
    
    // Public ingredients database (read-only)
    match /public_ingredients/{ingredientId} {
      allow read: if true; // Public access
      allow write: if false; // Admin only
    }
    
    // ============================================
    // WAITLIST & CONTACTS
    // ============================================
    
    match /contacts/{contactId} {
      // Allow anyone to CREATE waitlist entries (public signup)
      allow create: if request.resource.data.contactType == 'waitlist'
                    && isValidEmail(request.resource.data.email)
                    && isValidSize();
      
      // Authenticated users can read contacts
      allow read: if isAuthenticated();
      
      // Authenticated users can update/delete contacts
      allow update, delete: if isAuthenticated();
    }
    
    // ============================================
    // ANALYTICS & LOGS
    // ============================================
    
    match /analytics/{eventId} {
      // Users can write their own analytics
      allow create: if isAuthenticated() && isValidSize();
      
      // Only admins can read analytics
      allow read: if false; // Read via backend only
    }
    
    match /activity_logs/{logId} {
      // Users can create their own activity logs
      allow create: if isAuthenticated() && isValidSize();
      
      // Users can read their own logs
      allow read: if isAuthenticated() 
                  && resource.data.userId == request.auth.uid;
    }
    
    // ============================================
    // ADMIN COLLECTIONS
    // ============================================
    
    match /admin/{document=**} {
      allow read, write: if false; // Backend access only
    }
    
    // ============================================
    // DEFAULT: DENY ALL
    // ============================================
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

