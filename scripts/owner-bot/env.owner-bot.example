# Copy this file to .env.owner-bot in this folder (gitignored).
#   npm run owner-bot:init
# Then fill in ITERUM_TEST_EMAIL and ITERUM_TEST_PASSWORD.

ITERUM_BASE_URL=http://localhost:8080
ITERUM_TEST_EMAIL=
ITERUM_TEST_PASSWORD=

# Optional — merge Hot Chix / RBP menu into test plan
RBP_BUSINESS_PLAN_PATH=C:\Users\chefm\business_plan.json

# Browser: false = watch the owner walkthrough (recommended first run)
OWNER_BOT_HEADLESS=false

# Optional LLM owner agent (smarter steps; otherwise scripted persona)
# OPENAI_API_KEY=
# OWNER_BOT_AI=true
# OWNER_BOT_AI_MODEL=gpt-4o-mini

# OWNER_BOT_SKIP_AGENT=true
